{
  "name": "@sliiu/present-plugin-sdk",
  "version": "0.1.1",
  "license": "AGPL-3.0-or-later",
  "description": "Plugin SDK for the PPT player. Zero runtime dependencies; works in browser (ESM/IIFE) and Node (ESM/CJS).",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./iife": "./dist/plugin-sdk.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "COPYRIGHT",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sliiu/slimoffice.git",
    "directory": "present/plugin-sdk"
  },
  "homepage": "https://github.com/sliiu/slimoffice/tree/main/present/plugin-sdk",
  "bugs": {
    "url": "https://github.com/sliiu/slimoffice/issues"
  }
}
